<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sono base look: Material-dark tonal, rounded, no outlines on resting controls -->

  <Design.PreviewWith>
    <Border Width="400" Height="200" Background="{DynamicResource SonoCardBrush}">
      <TextBlock Text="preview" Foreground="{DynamicResource SonoTextBrush}"/>
    </Border>
  </Design.PreviewWith>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SonoCardBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <Style Selector="Border.elevated">
    <Setter Property="Background" Value="{DynamicResource SonoElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10"/>
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SonoMutedBrush}"/>
  </Style>

  <!-- rounded tonal slider -->
  <Style Selector="Slider.sono">
    <Setter Property="Foreground" Value="{DynamicResource SonoAccentBrush}"/>
  </Style>

  <Style Selector="Button.sono">
    <Setter Property="Background" Value="{DynamicResource SonoFieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== theme the FLUENT defaults so light/dark theme switches stay readable ===== -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>
  <Style Selector="CheckBox: pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SonoFieldBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SonoBorderBrush}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SonoFieldBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SonoBorderBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource SonoTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SonoElevatedBrush}"/>
  </Style>
</Styles>
